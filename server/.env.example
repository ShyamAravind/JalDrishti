# Copy this file to .env and fill in real values before running the server.
# NEVER commit the real .env file — it's already covered by .gitignore.

# ── REQUIRED ─────────────────────────────────────────────────────────────
# Port the Express server listens on. Most hosting platforms (Render,
# Railway, etc.) set this automatically at deploy time — the app already
# falls back to 4000 if it's unset, so you can leave this blank for local
# dev too.
PORT=

# Required for login to work at all (POST /api/auth/login returns a clear
# "not_configured" response without this). Any long random string works.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── OPTIONAL — Earth Engine (satellite analysis) ────────────────────────
# Without either of these two set, /api/earth-engine/* routes return a
# clear "not_configured" response — the rest of the app (GIS, map, login,
# recommendation engine, etc.) works fine without them.
#
# Set ONE of the two — EE_SERVICE_ACCOUNT_KEY_JSON is checked first if
# both happen to be set.
#
# Create a service account at
#   https://console.cloud.google.com/iam-admin/serviceaccounts
# and register it for Earth Engine at
#   https://signup.earthengine.google.com/#!/service_accounts

# Option A — local development: path to the downloaded JSON key file.
# NEVER commit the real key file — it's covered by .gitignore.
EE_SERVICE_ACCOUNT_KEY_PATH=

# Option B — cloud deployment: the complete JSON key file content, pasted
# as a single-line environment variable value. Use this on hosting
# platforms that don't support uploading secret files (most don't).
# To produce a single-line value from your downloaded key file, run:
#   node -e "console.log(JSON.stringify(require('./ee-service-account-key.json')))"
# and paste the entire output as this variable's value.
EE_SERVICE_ACCOUNT_KEY_JSON=

# ── OPTIONAL — Bhoonidhi satellite proxy ────────────────────────────────
# Without these, /api/satellite/* proxy routes return a clear
# "not_configured" response — nothing else in the app depends on them.
# Register at https://bhoonidhi.nrsc.gov.in if you want this working.
BHOONIDHI_USER=
BHOONIDHI_PASS=

# ── OPTIONAL — CORS origin allowlist for production ─────────────────────
# Comma-separated list of frontend origins allowed to call this backend
# (e.g. https://your-app.vercel.app). Leave blank to allow all origins,
# which is fine for a prototype/demo but not recommended for a real
# production deployment. Local development (localhost) always works
# regardless of this setting.
FRONTEND_ORIGIN=